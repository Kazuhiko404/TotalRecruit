    <ClCompile Include="route_rules_tests.cpp" />
    <ClCompile Include="defeat_rules_tests.cpp" />
    <ClCompile Include="mercy_rules_tests.cpp" />
    <ClCompile Include="..\..\src\chance_rules.cpp" />
